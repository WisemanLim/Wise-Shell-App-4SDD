[0.000, "o", "h\r\r\n"]
[0.015, "o", "\r\r\n  \u001b[1m\u001b[36mWSA4SDD App (v1.1.0)\u001b[0m — Service Deployment and Distribution Shell\r\r\n  \u001b[2mLives in your terminal, manages git repos, and deploys docker-compose.\u001b[0m\r\r\n"]
[0.000, "o", "  \u001b[2m─────────────────────────────────────────────────────────────────────────────\u001b[0m\r\r\n  Commands:\r\r\n    \u001b[1m/repo, /R [url[#branch] ...]\u001b[0m   Configure repo URLs (space/comma sep, optional #branch); manager if empty\r\r\n    \u001b[1m/workspace, /W [path]\u001b[0m       Configure target workspace directory path (or open menu if empty)\r\r\n"]
[0.000, "o", "    \u001b[1m/auth, /A [status|switch|login|pat]\u001b[0m  GitHub auth: gh status/switch/login or PAT (menu if empty)\r\r\n    \u001b[1m/bootstrap, /B\u001b[0m              System check + pre-install + sync repos (needs Repos/Workspace/Auth set)\r\r\n    \u001b[1m/status, /S\u001b[0m                 Show current configuration status\r\r\n    \u001b[1m/theme, /T [name]\u001b[0m           Switch color theme (dark|light|*-daltonized|*-ansi; menu if empty)\r\r\n    \u001b[1m/dist-run, /D\u001b[0m               Verify configurations and run make deployment\r\r\n    \u001b[1m/help, /H\u001b[0m                   Show this help message\r\r\n    \u001b[1m/exit, /E\u001b[0m                   Exit wsa4sdd shell and clear cache\r\r\n"]
[0.000, "o", "    \u001b[1m! <command>\u001b[0m                 Execute a shell command and display the output\r\r\n  \u001b[2m─────────────────────────────────────────────────────────────────────────────\u001b[0m\r\r\n\r\r\n"]
